# Main lifecycle script for fn-music-dl
# Handles start/stop/status commands from FNOS

PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
APP_BIN="${TRIM_APPDEST}/server/music-dl"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null
}

status_app() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi

    log_msg "Starting fn-music-dl..."
    echo "--- ENV ---" > "$LOG_FILE"
    echo "TRIM_APPDEST=$TRIM_APPDEST" >> "$LOG_FILE"
    echo "TRIM_PKGVAR=$TRIM_PKGVAR" >> "$LOG_FILE"
    echo "TRIM_DATA_SHARE_PATHS=$TRIM_DATA_SHARE_PATHS" >> "$LOG_FILE"
    echo "APP_BIN=$APP_BIN" >> "$LOG_FILE"
    echo "SOCKET_PATH=$SOCKET_PATH" >> "$LOG_FILE"
    echo "--- CHECK ---" >> "$LOG_FILE"

    if [ ! -f "$APP_BIN" ]; then
        echo "Binary not found: $APP_BIN" > "$TRIM_TEMP_LOGFILE"
        ls -la "$(dirname "$APP_BIN" 2>/dev/null)" >> "$TRIM_TEMP_LOGFILE" 2>&1 || true
        return 1
    fi

    if [ ! -x "$APP_BIN" ]; then
        chmod +x "$APP_BIN" 2>/dev/null || true
    fi

    file "$APP_BIN" >> "$LOG_FILE" 2>&1 || true

    # Set up environment
    export SOCKET_PATH="$SOCKET_PATH"
    export MUSIC_DL_CONFIG_DB="${TRIM_PKGVAR}/settings.db"

    # Run from TRIM_APPDEST so relative paths resolve relative to app root
    cd "$TRIM_APPDEST" 2>>"$LOG_FILE" || {
        echo "Failed to cd to TRIM_APPDEST=$TRIM_APPDEST" > "$TRIM_TEMP_LOGFILE"
        ls -la "$(dirname "$TRIM_APPDEST" 2>/dev/null)" >> "$TRIM_TEMP_LOGFILE" 2>&1 || true
        return 1
    }

    # Check for server dir
    if [ ! -d "server" ]; then
        echo "server/ directory not found under $TRIM_APPDEST" > "$TRIM_TEMP_LOGFILE"
        ls -la . >> "$TRIM_TEMP_LOGFILE" 2>&1
        return 1
    fi

    # Run the binary
    "$APP_BIN" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    log_msg "Started with PID $pid"

    # Wait and verify
    sleep 1
    if ! check_process "$pid"; then
        echo "Binary failed to start" > "$TRIM_TEMP_LOGFILE"
        echo "--- LAST 20 LOG LINES ---" >> "$TRIM_TEMP_LOGFILE"
        tail -20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE" 2>&1 || true
        echo "--- PID_FILE ---" >> "$TRIM_TEMP_LOGFILE"
        cat "$PID_FILE" >> "$TRIM_TEMP_LOGFILE" 2>&1 || true
        return 1
    fi

    log_msg "Start OK"
    return 0
}

stop_app() {
    log_msg "Stopping fn-music-dl..."

    if [ ! -f "$PID_FILE" ]; then
        rm -f "$SOCKET_PATH"
        return 0
    fi

    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -z "$pid" ] || ! check_process "$pid"; then
        rm -f "$PID_FILE"
        rm -f "$SOCKET_PATH"
        return 0
    fi

    kill -TERM "$pid" 2>> "$LOG_FILE" || true
    local count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "$pid"; then
        kill -KILL "$pid" 2>> "$LOG_FILE" || true
    fi

    rm -f "$PID_FILE"
    rm -f "$SOCKET_PATH"
    log_msg "Stopped"
    return 0
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if status_app; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
        exit 1
        ;;
esac
