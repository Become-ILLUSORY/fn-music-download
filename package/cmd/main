#!/bin/bash
# Main lifecycle script for fn-music-dl
# Handles start/stop/status commands from FNOS

# Defensive: use sane defaults when env vars are unset (e.g. during manual testing)
: "${TRIM_PKGVAR:=/tmp/music-dl-var}"
: "${TRIM_APPDEST:=/var/apps/music-dl/target}"
: "${TRIM_TEMP_LOGFILE:=/tmp/music-dl-temp.log}"

# Ensure log directory exists
mkdir -p "$TRIM_PKGVAR" 2>/dev/null || true

PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
APP_BIN="${TRIM_APPDEST}/server/music-dl"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

write_error() {
    echo "$1" > "$TRIM_TEMP_LOGFILE"
}

check_process() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null
}

status_app() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi

    # Init log file
    : > "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/music-dl-app.log"
    : > "$LOG_FILE" 2>/dev/null || true

    log_msg "Starting fn-music-dl..."
    echo "--- ENV ---" >> "$LOG_FILE"
    echo "TRIM_APPDEST=$TRIM_APPDEST" >> "$LOG_FILE"
    echo "TRIM_PKGVAR=$TRIM_PKGVAR" >> "$LOG_FILE"
    echo "TRIM_DATA_SHARE_PATHS=$TRIM_DATA_SHARE_PATHS" >> "$LOG_FILE"
    echo "APP_BIN=$APP_BIN" >> "$LOG_FILE"
    echo "SOCKET_PATH=$SOCKET_PATH" >> "$LOG_FILE"
    echo "PWD=$(pwd)" >> "$LOG_FILE"
    echo "--- CHECK ---" >> "$LOG_FILE"

    if [ ! -f "$APP_BIN" ]; then
        local msg="Binary not found at $APP_BIN"
        echo "$msg" >> "$LOG_FILE"
        write_error "$msg"
        ls -la "$(dirname "$APP_BIN" 2>/dev/null)" >> "$LOG_FILE" 2>&1 || true
        return 1
    fi

    chmod +x "$APP_BIN" 2>/dev/null || true

    file "$APP_BIN" >> "$LOG_FILE" 2>&1 || true

    # Ensure server dir exists
    local server_dir
    server_dir="$(dirname "$APP_BIN")"
    if [ ! -d "$server_dir" ]; then
        local msg="server dir not found: $server_dir"
        echo "$msg" >> "$LOG_FILE"
        write_error "$msg"
        return 1
    fi

    # Set up environment for the binary
    export SOCKET_PATH="$SOCKET_PATH"
    export MUSIC_DL_CONFIG_DB="${TRIM_PKGVAR}/settings.db"

    # Pass wizard download dir if set during install
    if [ -n "$wizard_download_dir" ]; then
        export MUSIC_DL_DOWNLOAD_DIR="$wizard_download_dir"
    fi

    # Also try to read from config env file
    if [ -f "${TRIM_PKGETC}/config.env" ]; then
        . "${TRIM_PKGETC}/config.env"
    fi

    # Change to the app root directory
    cd "$TRIM_APPDEST" 2>>"$LOG_FILE" || {
        local msg="Failed to cd to $TRIM_APPDEST"
        echo "$msg" >> "$LOG_FILE"
        write_error "$msg"
        return 1
    }

    log_msg "Launching binary..."
    log_msg "SOCKET_PATH=$SOCKET_PATH"
    log_msg "MUSIC_DL_CONFIG_DB=$MUSIC_DL_CONFIG_DB"

    # Run the binary in background
    "$APP_BIN" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    log_msg "PID=$pid"

    # Wait and verify still running
    sleep 2
    if ! check_process "$pid"; then
        local msg="Binary exited immediately"
        echo "$msg" >> "$LOG_FILE"
        write_error "$msg"
        echo "--- LAST 30 LOG LINES ---" >> "$LOG_FILE"
        tail -30 "$LOG_FILE" >> "$LOG_FILE" 2>&1 || true
        return 1
    fi

    # Verify socket was created (up to 5 seconds)
    local waited=0
    while [ $waited -lt 5 ]; do
        if [ -S "$SOCKET_PATH" ]; then
            log_msg "Socket ready at $SOCKET_PATH"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    # Process running but socket not ready yet — still OK
    log_msg "Process running, waiting for socket..."
    return 0
}

cleanup() {
    rm -f "$SOCKET_PATH" 2>/dev/null || true
}

stop_app() {
    log_msg "Stopping fn-music-dl..."

    if [ ! -f "$PID_FILE" ]; then
        cleanup
        return 0
    fi

    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -z "$pid" ] || ! check_process "$pid"; then
        rm -f "$PID_FILE"
        cleanup
        return 0
    fi

    kill -TERM "$pid" 2>> "$LOG_FILE" || true
    local count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "$pid"; then
        kill -KILL "$pid" 2>> "$LOG_FILE" || true
    fi

    rm -f "$PID_FILE"
    cleanup
    log_msg "Stopped"
    return 0
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if status_app; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
        exit 1
        ;;
esac
